#{extra}
<section>
  <div .display-grid>
    <div .margin-top-normal .display-grid>
      <label .font-weight-bold>* Genre Name:
      ^{fvInput genreNameView}
    <div .margin-top-normal .display-grid>
      <label .font-weight-bold>Link to additional information:
      <p>A link to a Wikipedia page for example, with more information.
      ^{fvInput genreLinkView}
    <div .margin-top-normal .display-grid>
      <label .font-weight-bold>Small description of the genre:
      ^{fvInput genreDescriptionView}
    <div .margin-top-normal .display-grid>
      <label .font-weight-bold>Image of the genre:
      ^{fvInput genreImageView}
    <div .margin-top-normal .display-grid>
      <label .font-weight-bold>Songs associated to the genre:
      <details .margin-bottom-normal .cursor-pointer>
        <summary>
          <small .font-weight-bold>What is this ?
        <p>
          Please input the associated songs to this genre, one per line
          You can find the identifiers in each tab's page, at the bottom.
          Format is artist/song/version | e.g. dio/rainbow-in-the-dark/1
      ^{fvInput genreTabsView}
    <div .margin-top-normal .display-grid>
      <label .font-weight-bold>Genre artists:
      ^{fvInput genreArtistsView}
