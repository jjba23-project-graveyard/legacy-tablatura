<section>
  <article>
    <h1>Editing #{tabArtistsListToHumanReadable (tabArtistNames tab)} - #{tabSongName tab} 
    <form method=post action=@{(TabEditR (tabArtistsListToURL (tabSearchKeyArtists (tabPk tab))) (tabSearchKeySong (tabPk tab)) (tabSearchKeyVersion (tabPk tab)) )} 
      enctype=#{enctype} onsubmit="return confirm('Do you really want to submit the form?');">
      ^{renderedTabEditForm}
      <div .margin-top-normal>
        <button #addEmptyCompass type="button">+ Add empty compass
        <button .button-submit type="submit">✓ Submit

<script>
  ^{importJsFile}

