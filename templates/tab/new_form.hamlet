#{extra}
<section>
  <div .display-grid>
    <div .margin-top-normal .display-grid>
      <label for="artistNameInput" .font-weight-bold>* Artist name:
      ^{fvInput artistNameView}
    <div .margin-top-normal .display-grid>
      <label for="songNameInput" .font-weight-bold>* Song name:
      ^{fvInput songNameView}
    <div .margin-top-normal .display-grid>
      <label for="songVersionInput" .font-weight-bold>* Version:
      <details .margin-bottom-normal .cursor-pointer>
        <summary>
          <small .font-weight-bold>What is this ?
        <p>
          Numeric field. Please verify, before adding a song via this form, that the content you are submitting does not exist already in Tablatura's database.
          If it does, please publish this form with a version number higher than we already have.
      ^{fvInput versionView}
    <div .margin-top-normal .display-grid>
      <label .font-weight-bold>Key:
      ^{fvInput tabKeyView}
    <div .margin-top-normal .display-grid>
      <label .font-weight-bold>Year of creation:
      ^{fvInput tabCreationYearView}
     <div .margin-top-normal .display-grid>
      <label .font-weight-bold>Name of the album:
      ^{fvInput tabAlbumNameView}
     <div .margin-top-normal .display-grid>
      <label .font-weight-bold>Link to more info about the album:
      ^{fvInput tabAlbumLinkView}
    <div .margin-top-normal .display-grid>
      <label .font-weight-bold>Tuning:
      ^{fvInput tabTuningView}
    <div .margin-top-normal .display-grid>
      <label .font-weight-bold>Image (album or related):
      <details .margin-bottom-normal .cursor-pointer>
        <summary>
          <small .font-weight-bold>Requirements for image uploads !
        <p>
          If no image is submitted, any existing image will be unmodified.
          Please ensure that the image you upload is of square dimensions, since it will be forcefully resized to 1:1 aspect ratio and 400x400 resolution.
          The image will be converted to WebP format and Base64 and stored at Tablatura's database.
    <div .margin-top-normal .display-grid>
      ^{fvInput tabImageView}
    <div .margin-top-normal .display-grid>
      <label for="tabLegend" .font-weight-bold>Musical legend in ASCII:
      <details .margin-bottom-normal .cursor-pointer>
        <summary>
          <small .font-weight-bold>What is this ?
        <p>
          Multi-line text field. Please explain the symbols, abbreviations and conventions used in the musical contents in ASCII.
      ^{fvInput legendView}
    <div .margin-top-normal .display-grid>
      <label .font-weight-bold>Genres of the song:
      <details .margin-bottom-normal .cursor-pointer>
        <summary>
          <small .font-weight-bold>What is this ?
        <p>
          Multi-line text field. Add all the genres the items belongs to, by identifier, one per line
      ^{fvInput tabGenreView}
    <div .margin-top-normal .display-grid>
      <label for="tabDisplay" .font-weight-bold>* Musical contents in ASCII:
      ^{fvInput tabView}
    <div .margin-top-normal .display-grid>
      <label .font-weight-bold>YouTube embed URL:
      <details .margin-bottom-normal .cursor-pointer>
        <summary>
          <small .font-weight-bold>What is this ?
        <p>
          URL field. Go to YouTube and copy the so-called iframe embed, then take the src part of it, and paste that URL here.
      ^{fvInput tabYouTubeEmbedURLView}
    <div .margin-top-normal  .display-grid>
      <label .font-weight-bold>Spotify embed URL:
      <details .margin-bottom-normal .cursor-pointer>
        <summary>
          <small .font-weight-bold>What is this ?
        <p>
          URL field. Go to Spotify and copy the so-called iframe embed, then take the src part of it, and paste that URL here.
      ^{fvInput tabSpotifyEmbedURLView}
