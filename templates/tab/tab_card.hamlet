<section>
  <article .shadow-style-tw>
    <div .card-grid-container>
      $forall Tab pk artistNames songName _ _ _ image imageType _ _ _ createdAt updatedAt _ approved _ _ _ likes dislikes _ _ <- allTabs 
        <div .card-grid-item .text-align-center>
          <a href="@{(TabR (tabArtistsListToURL (tabSearchKeyArtists pk)) (tabSearchKeySong pk) (tabSearchKeyVersion pk) )}">
            <div>
              $maybe imgSrc <- image
                $maybe imgType <- imageType
                  <img .border-radius-tiny loading="lazy" src="data:#{imgType};base64, #{imgSrc}">
                $nothing
                  <img .border-radius-tiny loading="lazy" src="">
            <h4>#{songName}
            <h6 .muted>#{tabArtistsListToHumanReadable artistNames}
          $if (not approved)
            <p>PENDING APPROVAL OF ADMINS!
          $#<small .muted .font-size-tiny >Updated at: #{show (epochToUTC updatedAt)}
          $#<small .muted .font-size-tiny >Created at: #{show (epochToUTC createdAt)}

  <footer>
    <button #tabPaginationPreviousButton >< Previous
    <button #tabPaginationNextButton >Next >
