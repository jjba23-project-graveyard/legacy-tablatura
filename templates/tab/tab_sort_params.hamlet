<section .sort-params-container .muted .flex-wrap-wrap .vertical-align-middle .align-items-center .justify-content-space-around>
  <div>
    <small>by artist:
    <a href="?#{show TabListSortBy}=#{show TabArtistAlphabetical}&#{show TabListOrientation}=#{show Ascending}">
      <small .link-color .font-weight-bold>A - Z
    <small>&nbsp;|&nbsp;
    <a href="?#{show TabListSortBy}=#{show TabArtistAlphabetical}&#{show TabListOrientation}=#{show Descending}">
      <small .link-color .font-weight-bold>Z - A
  
  <div>
    <small>by creation date:
    <a href="?#{show TabListSortBy}=#{show TabChronological}&#{show TabListOrientation}=#{show Ascending}">
      <small .link-color .font-weight-bold>Old
    <small>&nbsp;|&nbsp;
    <a href="?#{show TabListSortBy}=#{show TabChronological}&#{show TabListOrientation}=#{show Descending}">
      <small .link-color .font-weight-bold>New

  <div>
    <small>by song:
    <a href="?#{show TabListSortBy}=#{show TabSongAlphabetical}&#{show TabListOrientation}=#{show Ascending}">
      <small .link-color .font-weight-bold>A - Z
    <small>&nbsp;|&nbsp;
    <a href="?#{show TabListSortBy}=#{show TabSongAlphabetical}&#{show TabListOrientation}=#{show Descending}">
      <small .link-color .font-weight-bold>Z - A
