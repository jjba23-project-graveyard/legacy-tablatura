#{extra}
<section>
  <div .display-grid>
    <div .margin-top-normal .display-grid>
      <label .font-weight-bold>Link to more information:
      ^{fvInput artistLinkView}
    <div .margin-top-normal .display-grid>
      <label .font-weight-bold>Small description of the artist:
      ^{fvInput artistDescriptionView}
    <div .margin-top-normal .display-grid>
      <label .font-weight-bold>Image of the artist:
      ^{fvInput artistImageView}
    <div .margin-top-normal .display-grid>
      <label .font-weight-bold>Artist songs:
      <details .margin-bottom-normal .cursor-pointer>
        <summary>
          <small .font-weight-bold>What is this?
        <p>
          Please input the associated songs to this artist, one per line
          You can find the identifiers in each tab's page, at the bottom
          Format is artist/song/version | e.g. dio/rainbow-in-the-dark/1
      ^{fvInput artistTabsView}
    <div .margin-top-normal .display-grid>
      <label .font-weight-bold>Genres where this artist fits in:
      ^{fvInput artistGenresView}
