<section>
  <article .shadow-style-tw>
    <div .card-grid-container>
      $forall Artist name slug image imageType moreInfoLink description tabs artists createdAt lastEdited authorId approved _ _ likes dislikes <- allArtists 
        <div .card-grid-item .text-align-center>
          <a href="@{(ArtistR slug )}">
            <div>
              $maybe imgSrc <- image
                $maybe imgType <- imageType
                  <img .border-radius-tiny loading="lazy" src="data:#{imgType};base64, #{imgSrc}">
                $nothing
                  <img .border-radius-tiny loading="lazy" src="">
              $nothing
                <img .border-radius-tiny loading="lazy" src="">
            <h4>#{name}
            <h6 .muted>#{length tabs} songs
            $if (not approved)
              <p>PENDING APPROVAL OF ADMINS!
          $#<p .hs-margin-small .hs-text-small .hs-italic .hs-sans-serif .hs-text-black>Last edited: #{show (epochToUTC lastEdited)}
