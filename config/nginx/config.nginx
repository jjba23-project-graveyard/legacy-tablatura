# TABLATURA
server { 
  listen          80;
  server_name     tablatura.jjba.org;

  location /static/tmp/ {
    include reverse_proxy_params.nginx;  
    proxy_pass     http://tablatura_backend:3000; 
  }

  location /static/ {
    root /usr/share/nginx/;
    # Cache by default forever 
    # since Yesod handles hashing of files for us 
    expires max;
  }

  location / {
    include reverse_proxy_params.nginx;  
    proxy_pass      http://tablatura_backend:3000;
  }
}

server {
    listen 80;
    server_name www.tablatura.jjba.org;
    return 302 https://tablatura.jjba.org$request_uri;
}
